# Copiar a .env y cambiar valores. .env no se sube a git.
POSTGRES_DB=auth
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth-dev

# Debe ser el mismo secreto que usa FastAPI para validar los tokens. Mínimo 32 bytes.
VIGILA_JWT_SECRETO=secreto-solo-desarrollo-local-no-usar-en-produccion
VIGILA_CUADRILLA_SESION_DIAS=7
